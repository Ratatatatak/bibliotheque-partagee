# Copier ce fichier en .env.local (jamais commité) et remplacer les valeurs.

# Supabase : URL du projet et clé PUBLIQUE « anon » (Project Settings → API).
# Laisser vide pour utiliser le mode local de démonstration.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Jeton BoardGameGeek : variable SERVEUR (sans préfixe VITE_), jamais envoyée au navigateur.
BGG_API_TOKEN=replace-with-your-server-only-bgg-token

# Facultatif : forcer le mode local même si Supabase est configuré.
# VITE_LOCAL_DEMO_MODE=true

# Ne JAMAIS ajouter ici de clé service_role dans une variable VITE_*.
